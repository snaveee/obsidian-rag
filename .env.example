# ========================================================
# obsidian-rag Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env
#
# DO NOT commit real secrets or personal vault paths here.
# ========================================================

# 1. API Security (Required - change to your own secret)
API_KEY=your-secret-api-key-here

# 2. Vault Location (Defaults to sample_vault, set to your real vault locally)
ORAG_VAULT_PATH=sample_vault
ORAG_DATA_DIR=data

# 3. Local AI Services (Ollama)
OLLAMA_URL=http://localhost:11434
ORAG_GEN_MODEL=llama3.2:3b
ORAG_EMBED_MODEL=nomic-embed-text
ORAG_GEN_NUM_PREDICT=450
ORAG_GEN_NUM_CTX=8192

# 4. Hybrid Search & Reranking Defaults
ORAG_CHROMA_COLLECTION=obsidian_notes
ORAG_CHUNK_SIZE=800
ORAG_CHUNK_OVERLAP=120
ORAG_RERANK=true
ORAG_RERANKER_MODEL=BAAI/bge-reranker-base

# 5. Service & Frontend Ports
ORAG_API_URL=http://127.0.0.1:8001
ORAG_UI_PORT=8501

